# Copy to .env.statify-hosted.local. Never commit filled-in credentials.
STATIFY_HOSTED_ORIGIN=http://127.0.0.1:15288
STATIFY_HOSTED_PORT=15288
STATIFY_DEMO_SIGNING_KEY=
STATIFY_OPENAI_API_KEY_HACKATHON=
STATIFY_OPENAI_MODEL_GLOBAL=gpt-6.1-sol
CHANNEL3_API_KEY=
PAYPAL_SANDBOX_CLIENT_ID=
PAYPAL_SANDBOX_CLIENT_SECRET=
STATIFY_AI_DAILY_VISITOR_LIMIT=30
# Optional private writable directory. Omit to disable persistent memory.
# STATIFY_MEMORY_DIR=output/demo-memory
